# .env.prod.example — Copy thành .env.prod trên EC2 Prod
# Đặt tại: /opt/jobplatform/.env.prod
# chmod 600 /opt/jobplatform/.env.prod   ← chỉ owner mới đọc được

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=STRONG_PROD_PASSWORD_CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=STRONG_PROD_JWT_SECRET_MINIMUM_32_CHARS_CHANGE_ME

# ── Application ───────────────────────────────────────────────────
FRONTEND_URL=https://jobplatform.vn

# ── Email ─────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
