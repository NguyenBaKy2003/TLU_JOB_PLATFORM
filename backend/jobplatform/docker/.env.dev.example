# .env.dev.example — Copy thành .env.dev trên EC2 Dev
# Đặt tại: /opt/jobplatform/.env.dev
# KHÔNG commit file này lên Git (đã thêm vào .gitignore)

# ── Database ──────────
POSTGRES_PASSWORD=dev_password_change_me

# ── Redis ─────────────
REDIS_PASSWORD=dev_redis_password_change_me

# ── JWT ───────────────
# Generate: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-minimum-32-characters-long-change-me

# ── Application ───────
FRONTEND_URL=http://your-dev-ec2-ip-or-domain

# ── Email (Gmail App Password) ────────────────────────────────────
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── OpenAI (có thể bỏ qua ở dev) ─────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
